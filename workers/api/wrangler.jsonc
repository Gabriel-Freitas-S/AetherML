{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "aetherml-api",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aetherml-db",
			"database_id": "55d25065-ebc2-47a4-9fc3-16bbb96ef4ac"
		}
	],
	"r2_buckets": [
		{
			"binding": "MODELS",
			"bucket_name": "aetherml-models"
		}
	],
	"triggers": {
		"crons": ["0 * * * *", "0 6 * * 1"]
	}
}
