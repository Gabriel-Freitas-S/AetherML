---
import DashboardShell from "../components/DashboardShell.svelte";
// apps/web/src/pages/precisao.astro — rota preservada da seção "Precisão"
//
// Backtest IA vs real (holdout 7d), agora como seção do painel. A rota continua
// de pé e continua SSR do artefato: `evalData` e metadados das estações entram
// no shell já em tempo de build, então o HTML servido traz os números medidos
// antes de qualquer fetch e preserva as 9 estações ao trocar de aba.
import Layout from "../layouts/Layout.astro";
import { getShellStaticProps } from "../lib/shell-props";

const shellProps = getShellStaticProps("precisao");
---

<Layout title="AetherML — Precisão da IA vs Dados Reais">
  <DashboardShell client:load initialSection="precisao" {...shellProps} />
</Layout>