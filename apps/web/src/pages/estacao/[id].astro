---
import { globalIQAr } from "@aetherml/core-iqar";
import stationsData from "../../../public/data/stations-data.json";
import ForecastChart from "../../components/ForecastChart.svelte";

import Waterfall from "../../components/Waterfall.svelte";
// apps/web/src/pages/estacao/[id].astro — Diagnóstico por Estação RAMQAr
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	return Object.keys(stationsData).map((stationId) => ({
		params: { id: stationId },
		props: { data: (stationsData as any)[stationId] },
	}));
}

const { id } = Astro.params;
const { data } = Astro.props;
const station = data.station;

// Pontos previstos para o gráfico com cálculo CONAMA 491/2018 oficial
const points = data.points.map((p: any) => {
	const res = globalIQAr(p.observed);
	return {
		hour: p.hour,
		timestamp: p.timestamp,
		...p.observed,
		iqar: res.iqar,
		classification: res.classification,
		primary: res.primary,
	};
});

const nowMs = Date.now();
let currentPoint = points[0];
let minDiff = Math.abs(new Date(currentPoint.timestamp).getTime() - nowMs);
for (let i = 1; i < points.length; i++) {
	const diff = Math.abs(new Date(points[i].timestamp).getTime() - nowMs);
	if (diff < minDiff) {
		minDiff = diff;
		currentPoint = points[i];
	}
}

const saabasExample = [
	{ feature: "wind_direction", phi: station.downwind_tubarao ? 14.2 : 3.1 },
	{ feature: "boundary_layer_height", phi: 5.8 },
	{
		feature: "traffic_congestion_index",
		phi: station.bridge_proximity ? 12.5 : 4.0,
	},
	{ feature: "satellite_aod", phi: 2.3 },
	{ feature: "wind_speed", phi: -4.8 },
];

function getLocalDateStr(date: Date): string {
	return new Intl.DateTimeFormat("en-CA", {
		timeZone: "America/Sao_Paulo",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(date);
}

function formatDayCardLabel(dateStr: string, isToday: boolean): string {
	const [y, m, d] = dateStr.split("-").map(Number);
	const date = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
	const parts = new Intl.DateTimeFormat("pt-BR", {
		timeZone: "America/Sao_Paulo",
		weekday: "short",
		day: "2-digit",
		month: "2-digit",
	}).formatToParts(date);
	const get = (t: string) => parts.find((x) => x.type === t)?.value ?? "";
	let wd = get("weekday").replace(".", "");
	wd = wd.charAt(0).toUpperCase() + wd.slice(1);
	const label = `${wd} ${get("day")}/${get("month")}`;
	return isToday ? `Hoje · ${label}` : label;
}

const todayStr = getLocalDateStr(new Date());
const groups = new Map<string, any[]>();
for (const p of points) {
	const dStr = getLocalDateStr(new Date(p.timestamp));
	if (dStr < todayStr) continue;
	const arr = groups.get(dStr) ?? [];
	arr.push(p);
	groups.set(dStr, arr);
}

let sortedDates = Array.from(groups.keys()).sort();
if (sortedDates.length === 0) {
	const fallbackGroups = new Map<string, any[]>();
	for (const p of points) {
		const dStr = getLocalDateStr(new Date(p.timestamp));
		const arr = fallbackGroups.get(dStr) ?? [];
		arr.push(p);
		fallbackGroups.set(dStr, arr);
	}
	sortedDates = Array.from(fallbackGroups.keys()).sort();
	for (const [k, v] of fallbackGroups.entries()) {
		groups.set(k, v);
	}
}

const targetDates = sortedDates.slice(0, 5);
const fiveDaysForecast = targetDates.map((dateStr, dayIdx) => {
	const dayPoints = groups.get(dateStr) ?? [];
	const maxIqar = Math.max(...dayPoints.map((p: any) => p.iqar));
	const avgIqar = Math.round(
		dayPoints.reduce((acc: number, p: any) => acc + p.iqar, 0) /
			Math.max(1, dayPoints.length),
	);
	const peakPoint =
		dayPoints.find((p: any) => p.iqar === maxIqar) || dayPoints[0];
	const isToday = dateStr === todayStr || dayIdx === 0;
	return {
		dayNumber: dayIdx + 1,
		date: dateStr,
		label: formatDayCardLabel(dateStr, isToday),
		maxIqar,
		avgIqar,
		classification: peakPoint.classification,
		primary: String(peakPoint.primary).toUpperCase(),
	};
});

function badgeClass(cls?: string): string {
	switch (cls) {
		case "Boa":
			return "badge-boa";
		case "Moderada":
			return "badge-moderada";
		case "Ruim":
			return "badge-ruim";
		case "Muito Ruim":
			return "badge-muitoruim";
		default:
			return "badge-pessima";
	}
}

function iqarHex(cls?: string): string {
	switch (cls) {
		case "Boa":
			return "#10b981";
		case "Moderada":
			return "#f59e0b";
		case "Ruim":
			return "#f97316";
		case "Muito Ruim":
			return "#ef4444";
		default:
			return "#a855f7";
	}
}

function iqarTextColor(cls?: string): string {
	switch (cls) {
		case "Boa":
			return "#047857";
		case "Moderada":
			return "#b45309";
		case "Ruim":
			return "#c2410c";
		case "Muito Ruim":
			return "#b91c1c";
		default:
			return "#7e22ce";
	}
}

const DEFAULT_IQAR_ICON = "i-ph-shield-warning-fill";
const IQAR_ICONS: Record<string, string> = {
	Boa: "i-ph-check-circle-fill",
	Moderada: "i-ph-warning-circle-fill",
	Ruim: "i-ph-warning-fill",
	"Muito Ruim": "i-ph-warning-octagon-fill",
	Péssima: DEFAULT_IQAR_ICON,
};

function iqarIcon(cls?: string): string {
	return (cls && IQAR_ICONS[cls]) || DEFAULT_IQAR_ICON;
}
---

<Layout title={`AetherML — ${station.name}`}>
  <div class="mb-6 flex justify-between items-center flex-wrap gap-4 anim-fade-up">
    <div>
      <a href="/" class="text-xs text-sky-700 hover:underline inline-flex items-center gap-1.5 mb-2 font-semibold min-h-[38px] sm:min-h-0">
        <span class="i-ph-arrow-left-bold w-3.5 h-3.5"></span> Voltar ao Dashboard Geral
      </a>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 flex items-center gap-2 tracking-tight">
        {station.name}
      </h1>
      <p class="text-slate-500 text-sm mt-0.5">
        Município: <strong class="text-slate-700">{station.municipality}</strong> &bull;
        Coordenadas: <span class="font-mono text-slate-600">{station.lat}, {station.lon}</span>
      </p>
    </div>

    <!-- Status Atual da Estação -->
    <div class="bg-white border border-slate-200 px-5 py-3 rounded-2xl flex items-center gap-4 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-1" style={`background: ${iqarHex(currentPoint.classification)}`}></div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">IQAr Atual &bull; Tempo Real</div>
        <div class="text-3xl font-black font-mono tabular-nums" style={`color: ${iqarTextColor(currentPoint.classification)}`}>{currentPoint.iqar}</div>
      </div>
      <div class="text-xs">
        <span class={`chip font-bold ${badgeClass(currentPoint.classification)} flex items-center gap-1.5`}>
          <span class={`${iqarIcon(currentPoint.classification)} w-3.5 h-3.5`}></span>
          <span>{currentPoint.classification}</span>
        </span>
        <div class="text-slate-500 text-[11px] mt-1">Crítico: {currentPoint.primary.toUpperCase()}</div>
      </div>
    </div>
  </div>

  <!-- Visão Geral de 5 Dias por Machine Learning da Estação -->
  <div class="mb-6 anim-fade-up-d1">
    <div class="mb-2.5 flex items-center justify-between">
      <h2 class="text-sm font-bold text-slate-600 uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        Prognóstico de 5 Dias (120 Horas Contínuas)
      </h2>
      <span class="text-xs text-slate-500 font-mono">Resolução Horária CONAMA 491</span>
    </div>
    <div class="flex sm:grid sm:grid-cols-3 lg:grid-cols-5 gap-3.5 overflow-x-auto pb-2 snap-x snap-mandatory">
      {fiveDaysForecast.map((day, idx) => (
        <div class="glass-card glass-card-hover p-4 text-center relative overflow-hidden min-w-[145px] sm:min-w-0 snap-start flex-1" style={`animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) ${0.05 + idx * 0.04}s both`}>
          <div class="absolute top-0 inset-x-0 h-0.5" style={`background: ${iqarHex(day.classification)}`}></div>
          <div class="text-[11px] text-slate-500 font-bold uppercase tracking-wider">{day.label}</div>
          <div class="text-2xl font-black font-mono my-1 text-slate-900 tabular-nums">{day.avgIqar}</div>
          <span class={`chip !text-[10px] font-bold ${badgeClass(day.classification)} flex items-center justify-center gap-1`}>
            <span class={`${iqarIcon(day.classification)} w-3 h-3`}></span>
            <span>{day.classification}</span>
          </span>
          <div class="text-[10px] text-slate-500 mt-1.5 font-mono">
            Pico {day.maxIqar} &bull; {day.primary}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Série Preditiva de 5 Dias / 120h -->
  <div class="mb-8">
    <ForecastChart client:load points={points} activePollutant="iqar" />
  </div>

  <!-- Decomposição Saabas -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 content-visibility-auto">
    <div class="lg:col-span-8">
      <Waterfall
        client:visible
        contributions={saabasExample}
        stationName={station.name}
        primaryPollutant="pm25"
        baseValue={14.5}
      />
    </div>

    <div class="lg:col-span-4 glass-card p-5">
      <h3 class="text-base font-bold text-slate-800 mb-3">Recomendações de Saúde</h3>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        Conforme a Resolução CONAMA nº 491/2018 para a faixa <strong>{currentPoint.classification}</strong>:
      </p>
      <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
        {currentPoint.classification === 'Boa'
          ? 'Qualidade do ar considerada satisfatória. Não há restrições para atividades ao ar livre.'
          : 'Pessoas de grupos sensíveis (crianças, idosos, asmáticos e cardiopatas) podem apresentar sintomas como tosse e cansaço. Recomenda-se evitar esforço intenso ao ar livre.'}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-200 text-xs text-slate-500 space-y-2">
        <div class="flex justify-between">
          <span>Fonte Primária de Dados:</span>
          <strong class="text-slate-700">IEMA / RAMQAr</strong>
        </div>
        <div class="flex justify-between">
          <span>Cache DB-First:</span>
          <strong class="text-emerald-700 font-mono">D1/SQLite Ativo</strong>
        </div>
      </div>
    </div>
  </div>
</Layout>
