---
import { globalIQAr } from "@aetherml/core-iqar";
import stationsData from "../../../public/data/stations-data.json";
import ForecastChart from "../../components/ForecastChart.svelte";

import Waterfall from "../../components/Waterfall.svelte";
import Layout from "../../layouts/Layout.astro";
import {
	POLLUTANT_LABEL,
	type PollutantKey,
	badgeClass,
	iqarAdvice,
	iqarHex,
	iqarIcon,
	iqarTextColor,
} from "../../lib/comparison";
// apps/web/src/pages/estacao/[id].astro — Diagnóstico por Estação RAMQAr
import { currentPoint as pickCurrentPoint } from "../../lib/current-point";
import {
	buildFiveDayCards,
	describeDataAge,
	formatStaleNotice,
} from "../../lib/forecast-days";

export async function getStaticPaths() {
	return Object.keys(stationsData).map((stationId) => ({
		params: { id: stationId },
		props: { data: (stationsData as any)[stationId] },
	}));
}

const { id } = Astro.params;
const { data } = Astro.props;
const station = data.station;

// Pontos previstos para o gráfico com cálculo CONAMA 491/2018 oficial
const points = data.points.map((p: any) => {
	const res = globalIQAr(p.observed);
	return {
		hour: p.hour,
		timestamp: p.timestamp,
		features: p.features,
		...p.observed,
		iqar: res.iqar,
		classification: res.classification,
		primary: res.primary,
	};
});

// IQAr Atual: o ponto mais recente com `timestamp <= now` — mesma função do mapa e
// do Dashboard, para que as três telas nunca mostrem números diferentes.
const currentPoint =
	pickCurrentPoint(points, Date.now())?.point ?? points[0] ?? null;

// Toda a lógica de dia local, rótulo de cartão e estado "desatualizado" vive em
// ../../lib/forecast-days — é a mesma cópia usada pelo Dashboard.svelte.
const {
	cards: fiveDaysForecast,
	isStale,
	referenceTimestamp,
} = buildFiveDayCards(points as any);
const dataAge = describeDataAge(referenceTimestamp);
const staleNotice = formatStaleNotice(dataAge);

function formatPollutant(pol?: string): string {
	if (!pol) return "—";
	return (
		POLLUTANT_LABEL[pol.toLowerCase() as PollutantKey] ?? pol.toUpperCase()
	);
}
---

<Layout title={`AetherML — ${station.name}`}>
  <div class="mb-6 flex justify-between items-center flex-wrap gap-4 anim-fade-up">
    <div>
      <a href="/" class="text-xs text-sky-700 hover:underline inline-flex items-center gap-1.5 mb-2 font-semibold min-h-[44px] sm:min-h-0">
        <span class="i-ph-arrow-left-bold w-3.5 h-3.5"></span> Voltar ao Dashboard Geral
      </a>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 flex items-center gap-2 tracking-tight">
        {station.name}
      </h1>
      <p class="text-slate-500 text-sm mt-0.5">
        Município: <strong class="text-slate-700">{station.municipality}</strong> &bull;
        Coordenadas: <span class="font-mono text-slate-600">{station.lat}, {station.lon}</span>
      </p>
    </div>

    <!-- Status Atual da Estação -->
    <div class="bg-white border border-slate-200 px-5 py-3.5 rounded-2xl flex items-center gap-4 shadow-sm relative overflow-hidden w-full sm:w-auto">
      <div class="absolute top-0 inset-x-0 h-1" style={`background: ${iqarHex(currentPoint?.classification)}`}></div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">IQAr Atual &bull; Estação</div>
        <div class="text-3xl sm:text-4xl font-black font-mono tabular-nums" style={`color: ${iqarTextColor(currentPoint?.classification)}`}>{currentPoint?.iqar ?? "—"}</div>
      </div>
      <div class="text-xs">
        <span class={`chip font-bold ${badgeClass(currentPoint?.classification)} flex items-center gap-1.5 w-fit`}>
          <span class={`${iqarIcon(currentPoint?.classification)} w-3.5 h-3.5`}></span>
          <span>{currentPoint?.classification ?? "—"}</span>
        </span>
        <div class="text-slate-600 text-[11px] mt-1">Dominante: <strong class="text-slate-800">{formatPollutant(currentPoint?.primary)}</strong></div>
        <div class="text-slate-500 text-[10px] mt-0.5 uppercase tracking-wider font-semibold">Estimativa horária (CONAMA 491)</div>
      </div>
    </div>
  </div>

  <!-- Visão Geral de 5 Dias por Machine Learning da Estação -->
  <div class="mb-6 anim-fade-up-d1">
    {isStale && (
      <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-900 text-sm rounded-2xl px-4 py-3 flex items-start gap-2.5" role="alert">
        <span class="i-ph-warning-fill w-4 h-4 text-amber-600 shrink-0 mt-0.5"></span>
        <span>
          <strong>{staleNotice.title}.</strong> {staleNotice.body}
        </span>
      </div>
    )}
    <div class="mb-2.5 flex items-center justify-between flex-wrap gap-2">
      <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        {isStale ? "Histórico do Modelo por Dia" : "Prognóstico de 5 Dias (120 Horas Contínuas)"}
      </h2>
      <span class="text-xs text-slate-500 font-mono">
        {dataAge.observedAt ? `Dados até ${dataAge.observedAt} (${dataAge.ageText})` : "Resolução Horária CONAMA 491"}
      </span>
    </div>
    <div class="flex sm:grid sm:grid-cols-3 lg:grid-cols-5 gap-3.5 overflow-x-auto pb-2 snap-x snap-mandatory">
      {fiveDaysForecast.map((day, idx) => (
        <div class="glass-card glass-card-hover p-4 text-center relative overflow-hidden min-w-[155px] sm:min-w-0 snap-start flex-1 flex flex-col" style={`animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) ${0.05 + idx * 0.04}s both`}>
          <div class="absolute top-0 inset-x-0 h-0.5" style={`background: ${iqarHex(day.classification)}`}></div>
          <div class="text-[11px] text-slate-500 font-bold uppercase tracking-wider">{day.label}</div>
          <div class="mt-1">
            <span class="text-3xl font-black font-mono leading-none text-slate-900 tabular-nums">{day.avgIqar}</span>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-1">média do dia</span>
          </div>
          <span class={`chip mt-2 self-center !text-[10px] font-bold ${badgeClass(day.classification)} flex items-center justify-center gap-1`}>
            <span class={`${iqarIcon(day.classification)} w-3 h-3`}></span>
            <span>{day.classification}</span>
          </span>
          <div class="mt-auto pt-2.5 border-t border-slate-200 text-[11px] text-slate-500">
            <span class="uppercase tracking-wider text-[9px] font-bold text-slate-500">pico horário</span>
            <span class="font-mono font-semibold text-slate-700 ml-1">{day.maxIqar}</span>
            <span class="text-slate-300 mx-0.5">&middot;</span>
            <span>{formatPollutant(day.primary)}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Série Preditiva de 5 Dias / 120h -->
  <div class="mb-8">
    <ForecastChart client:load points={points} activePollutant="iqar" />
  </div>

  <!-- Decomposição Saabas -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 content-visibility-auto">
    <div class="lg:col-span-8">
      <Waterfall
        client:visible
        contributions={[]}
        stationId={id}
        features={currentPoint?.features ?? null}
        stationName={station.name}
        primaryPollutant={currentPoint?.primary ?? "pm25"}
        baseValue={14.5}
      />
    </div>

    <div class="lg:col-span-4 glass-card p-5 relative overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-0.5" style={`background: ${iqarHex(currentPoint?.classification)}`}></div>
      <h3 class="text-base font-bold text-slate-800 mb-3">Recomendações de Saúde</h3>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        Conforme a Resolução CONAMA nº 491/2018 para a faixa <strong>{currentPoint?.classification ?? "—"}</strong>:
      </p>
      <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs text-slate-700 leading-relaxed">
        {iqarAdvice(currentPoint?.classification)}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-200 text-xs text-slate-500 space-y-2">
        <div class="flex justify-between">
          <span>Fonte Primária de Dados:</span>
          <strong class="text-slate-700">IEMA / RAMQAr</strong>
        </div>
        <div class="flex justify-between">
          <span>Cache DB-First:</span>
          <strong class="text-emerald-700 font-mono">D1/SQLite Ativo</strong>
        </div>
      </div>
    </div>
  </div>
</Layout>
