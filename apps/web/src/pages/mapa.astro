---
import { globalIQAr } from "@aetherml/core-iqar";
import stationsData from "../../public/data/stations-data.json";
import DashboardShell from "../components/DashboardShell.svelte";
// apps/web/src/pages/mapa.astro — rota preservada da seção "Mapa"
//
// A rota NÃO foi apagada: ela renderiza o MESMO painel de `/`, com a seção
// "Mapa" já selecionada. É o que mantém um link antigo, um QR code em documento
// técnico ou uma URL colada em e-mail abrindo a seção certa, e é o que faz a aba
// funcionar sem JavaScript (`href` da aba = esta rota).
//
// `client:load` e não `client:only`: com SSR o mapa, a legenda e a lista das 9
// estações chegam como HTML. A única coisa que precisa do browser é a instância
// Leaflet, criada em `onMount`.
import Layout from "../layouts/Layout.astro";
import { currentPoint } from "../lib/current-point";
import { dominantConcentration } from "../lib/dashboard-sections";

const nowMs = Date.now();
// Mesma semântica do Dashboard e de estacao/[id].astro: o IQAr do marcador é o do
// ponto mais recente com `timestamp <= now`, nunca o ponto futuro mais próximo.
const initialMapStations = Object.values(stationsData as any)
	.map((item: any) => {
		const picked = currentPoint(item.points, nowMs);
		if (!picked) return null;
		const res = globalIQAr(picked.point.observed);
		return {
			id: item.station.id,
			name: item.station.name,
			municipality: item.station.municipality,
			latitude: item.station.latitude ?? item.station.lat,
			longitude: item.station.longitude ?? item.station.lon,
			iqar: res.iqar,
			classification: res.classification,
			primary: res.primary,
			concentration: dominantConcentration(picked.point.observed, res.primary),
		};
	})
	.filter((s) => s !== null);
---

<Layout
  title="AetherML — Mapa Espacial da Grande Vitória"
  description="Mapa das 9 estações RAMQAr da Grande Vitória com o IQAr CONAMA 491/2018 e a concentração em µg/m³ do poluente dominante, estação a estação."
>
  <DashboardShell client:load initialSection="mapa" initialMapStations={initialMapStations} />
</Layout>