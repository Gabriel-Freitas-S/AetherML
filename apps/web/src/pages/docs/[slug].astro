---
import fs from "node:fs";
import path from "node:path";

// apps/web/src/pages/docs/[slug].astro — Artigo com sidebar, índice e prev/next
import Layout from "../../layouts/Layout.astro";
import { GUIDES, neighbors } from "../../lib/guides";

export async function getStaticPaths() {
	const docsDir = path.resolve("../../docs");
	const files = fs.readdirSync(docsDir).filter((f) => f.endsWith(".md"));

	return files.map((file) => {
		const slug = file.replace(".md", "");
		const fullPath = path.join(docsDir, file);
		const content = fs.readFileSync(fullPath, "utf-8");
		return {
			params: { slug },
			props: { slug, content, filename: file },
		};
	});
}

const { slug, content, filename } = Astro.props;
const { prev, next } = neighbors(slug);
const current = GUIDES.find((g) => g.slug === slug);
const startGuides = GUIDES.filter((g) => g.track === "start");
const techGuides = GUIDES.filter((g) => g.track === "tech");

import { renderMarkdown } from "../../lib/markdown";

const renderedHtml = renderMarkdown(content);
---

<Layout title={current ? `AetherML — ${current.title}` : `AetherML Docs — ${slug}`}>
  <div class="max-w-6xl mx-auto py-4 grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Sidebar Desktop -->
    <aside class="hidden lg:block lg:col-span-3">
      <div class="lg:sticky lg:top-24 glass-card p-4 max-h-[70vh] overflow-y-auto">
        <a href="/docs" class="flex items-center gap-2 text-xs font-bold text-sky-700 hover:underline mb-3 px-1">
          <span class="i-ph-arrow-left-bold w-3.5 h-3.5"></span> Todos os guias
        </a>
        <p class="px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Comece aqui</p>
        {startGuides.map((g) => (
          <a href={`/docs/${g.slug}`} class={`flex items-center gap-2 px-2.5 py-2 rounded-lg text-[13px] font-medium transition-colors ${g.slug === slug ? "bg-sky-50 text-sky-800 font-bold" : "text-slate-600 hover:bg-slate-100"}`}>
            <span class={`${g.icon} w-4 h-4 shrink-0`}></span> {g.title}
          </a>
        ))}
        <p class="px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-3 mb-1">Técnico</p>
        {techGuides.map((g) => (
          <a href={`/docs/${g.slug}`} class={`flex items-center gap-2 px-2.5 py-2 rounded-lg text-[13px] font-medium transition-colors ${g.slug === slug ? "bg-sky-50 text-sky-800 font-bold" : "text-slate-600 hover:bg-slate-100"}`}>
            <span class="font-mono text-[11px] text-slate-400 w-6 shrink-0">{g.number}</span> {g.title}
          </a>
        ))}
      </div>
    </aside>

    <!-- Artigo Principal -->
    <div class="lg:col-span-9">
      <div class="mb-4 flex items-center justify-between text-xs text-slate-400 flex-wrap gap-2">
        <span class="flex items-center gap-1.5">
          {current && <span class={`${current.icon} w-4 h-4 text-sky-600`}></span>}
          <span class="font-semibold text-slate-500">{current?.badge ?? "Guia"}</span>
        </span>
        <span class="font-mono bg-slate-100 px-2 py-0.5 rounded border border-slate-200">docs/{filename}</span>
      </div>

      <!-- Seletor de Guias Móvel (Gaveta recolhível para leitura imediata do artigo) -->
      <details class="lg:hidden glass-card p-3 mb-4 rounded-xl text-sm group">
        <summary class="cursor-pointer font-bold text-sky-800 flex items-center justify-between py-1 px-1 select-none min-h-[44px]">
          <span class="flex items-center gap-2">
            <span class="i-ph-list-bold w-4 h-4 text-sky-600"></span>
            <span>Índice de Guias &bull; {current?.number ?? "Docs"}</span>
          </span>
          <span class="i-ph-caret-down-bold w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform"></span>
        </summary>
        <div class="mt-3 pt-3 border-t border-slate-200 space-y-1 max-h-[55vh] overflow-y-auto">
          <a href="/docs" class="flex items-center gap-2 text-xs font-bold text-sky-700 hover:underline mb-2 px-2 py-1.5">
            <span class="i-ph-arrow-left-bold w-3.5 h-3.5"></span> Todos os guias
          </a>
          <p class="px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Comece aqui</p>
          {startGuides.map((g) => (
            <a href={`/docs/${g.slug}`} class={`flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors min-h-[44px] ${g.slug === slug ? "bg-sky-50 text-sky-800 font-bold" : "text-slate-600 hover:bg-slate-100"}`}>
              <span class={`${g.icon} w-4 h-4 shrink-0`}></span> {g.title}
            </a>
          ))}
          <p class="px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-3 mb-1">Técnico</p>
          {techGuides.map((g) => (
            <a href={`/docs/${g.slug}`} class={`flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors min-h-[44px] ${g.slug === slug ? "bg-sky-50 text-sky-800 font-bold" : "text-slate-600 hover:bg-slate-100"}`}>
              <span class="font-mono text-xs text-slate-400 w-6 shrink-0">{g.number}</span> {g.title}
            </a>
          ))}
        </div>
      </details>

      <article class="glass-card p-6 sm:p-10 leading-relaxed">
        <div class="max-w-none" set:html={renderedHtml} />
      </article>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {prev ? (
          <a href={`/docs/${prev.slug}`} class="glass-card glass-card-hover p-4 group">
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">← Anterior</span>
            <span class="block text-sm font-bold text-slate-800 group-hover:text-sky-700 mt-0.5">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/docs/${next.slug}`} class="glass-card glass-card-hover p-4 text-right group">
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Próximo →</span>
            <span class="block text-sm font-bold text-slate-800 group-hover:text-sky-700 mt-0.5">{next.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </div>

  <!-- Barra de progresso de leitura -->
  <script is:inline>
    const bar = document.createElement('div');
    bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;width:0;z-index:60;background:linear-gradient(90deg,#0284c7,#10b981)';
    document.body.appendChild(bar);
    addEventListener('scroll', () => {
      const h = document.documentElement;
      const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
      bar.style.width = `${Math.round(p * 100)}%`;
    }, { passive: true });
  </script>
</Layout>
