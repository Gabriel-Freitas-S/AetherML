---
// apps/web/src/pages/comparacao.astro — rota legada preservada p/ sub-aba "Holdout" em Confronto
//
// ML × Open-Meteo no HOLDOUT (passado). Abre diretamente a seção "Confronto" na
// sub-aba "Holdout — 168h de validação" (`comparison-data.json`), preservando
// links existentes e o aviso de que holdout e previsão futura têm naturezas distintas.
import comparisonData from "../../public/data/comparison-data.json";
import DashboardShell from "../components/DashboardShell.svelte";
import Layout from "../layouts/Layout.astro";
import { getShellStaticProps } from "../lib/shell-props";

const HOLDOUT_HOURS = comparisonData.holdout.hours;
const shellProps = getShellStaticProps();
---

<Layout
  title="AetherML — Modelo vs Open-Meteo no holdout"
  description={`Comparação hora a hora entre a previsão calibrada do modelo e a re-análise CAMS/Open-Meteo numa janela de holdout de ${HOLDOUT_HOURS} horas (dados passados, fora do treino), com resíduos e métricas por poluente e por estação.`}
>
  <DashboardShell
    client:load
    initialSection="confronto"
    initialSubtab="holdout"
    {...shellProps}
  />
</Layout>