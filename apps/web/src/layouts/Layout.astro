---
// apps/web/src/layouts/Layout.astro — Tema claro
import "katex/dist/katex.min.css";

import { DASHBOARD_SECTIONS } from "../lib/dashboard-sections";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "AetherML — Previsão de Qualidade do Ar RMGV (5 Dias ML)",
	description = "Previsão inteligente horária de 5 dias e classificação regulatória CONAMA 491/2018 para a Grande Vitória via WebAssembly na borda.",
} = Astro.props;

const currentPath = Astro.url.pathname;

/** "/mapa/" e "/mapa" são a mesma rota para efeito de estado ativo. */
function normalize(path: string): string {
	return path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;
}

const current = normalize(currentPath);

/**
 * A navegação tem DOIS itens porque o produto tem duas superfícies de leitura:
 * o painel e a documentação. Mapa, Precisão, Previsão e Holdout não
 * desapareceram — viraram SEÇÕES do painel (`lib/dashboard-sections.ts`), e cada
 * uma continua com a sua rota. Por isso "Dashboard" acende em qualquer uma
 * delas: um link profundo para `/mapa` mostra o mesmo produto, com a seção certa
 * já aberta.
 */
function isActive(href: string): boolean {
	const target = normalize(href);
	if (target === "/") {
		return DASHBOARD_SECTIONS.some((s) => normalize(s.href) === current);
	}
	return current === target || current.startsWith(`${target}/`);
}
function navClass(href: string): string {
	return isActive(href)
		? "px-3.5 py-1.5 rounded-full bg-white text-sky-700 font-bold shadow-sm"
		: "px-3.5 py-1.5 rounded-full text-slate-500 hover:bg-white hover:text-sky-700 hover:shadow-sm transition-all";
}
function mobileNavClass(href: string): string {
	return isActive(href)
		? "flex items-center min-h-[44px] px-3.5 py-2.5 rounded-xl text-sky-950 font-bold bg-sky-50 transition-colors"
		: "flex items-center min-h-[44px] px-3.5 py-2.5 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors";
}
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0284c7" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="AetherML" />

  <!-- Leaflet CSS (Self-hosted para PWA offline-first) -->
  <link rel="stylesheet" href="/leaflet/leaflet.css" />

  <!-- Google Fonts: Outfit + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    html {
      scroll-behavior: smooth;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background:
        radial-gradient(900px 420px at 12% -5%, rgba(14, 165, 233, 0.10), transparent 60%),
        radial-gradient(800px 380px at 88% 0%, rgba(16, 185, 129, 0.10), transparent 60%),
        linear-gradient(180deg, #f0f7fc 0%, #f8fafc 320px, #f8fafc 100%);
      background-color: #f6f9fc;
      color: #0f172a;
      min-height: 100vh;
      overflow-x: hidden;
      padding-top: env(safe-area-inset-top, 0px);
      padding-left: env(safe-area-inset-left, 0px);
      padding-right: env(safe-area-inset-right, 0px);
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    ::selection {
      background: rgba(14, 165, 233, 0.25);
    }
    :focus-visible {
      outline: 2px solid #0284c7;
      outline-offset: 2px;
      border-radius: 6px;
    }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; border: 2px solid #f6f9fc; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* ─── Animações de entrada e movimento natural ─── */
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .anim-fade-up {
      animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .anim-fade-up-d1 { animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .anim-fade-up-d2 { animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) 0.10s both; }
    .anim-fade-up-d3 { animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
    .anim-fade-up-d4 { animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) 0.20s both; }
    .anim-fade-up-d5 { animation: fadeSlideUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
    .anim-fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    /* ─── Otimização de Renderização Offscreen (LCP / TBT) ─── */
    .content-visibility-auto {
      content-visibility: auto;
      contain-intrinsic-size: 0 500px;
    }
    /* ─── Menu Hambúrguer Animado (morphing suave para X) ─── */
    .hamburger-box {
      width: 20px;
      height: 14px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
    }
    .hamburger-bar {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 9999px;
      background-color: #334155;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, background-color 0.2s ease;
      transform-origin: center;
    }
    #nav-toggle:hover .hamburger-bar {
      background-color: #0284c7;
    }
    #nav-toggle[aria-expanded="true"] .top-bar {
      transform: translateY(6px) rotate(45deg);
    }
    #nav-toggle[aria-expanded="true"] .mid-bar {
      opacity: 0;
      transform: scaleX(0);
    }
    #nav-toggle[aria-expanded="true"] .bot-bar {
      transform: translateY(-6px) rotate(-45deg);
    }

    #mobile-nav:not(.hidden) {
      animation: mobileNavDown 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes mobileNavDown {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .anim-fade-up,
      .anim-fade-up-d1,
      .anim-fade-up-d2,
      .anim-fade-up-d3,
      .anim-fade-up-d4,
      .anim-fade-up-d5,
      .anim-fade-in,
      #mobile-nav:not(.hidden) {
        animation: none !important;
        transform: none !important;
      }
      .hamburger-bar {
        transition: none !important;
      }
    }
  </style>
</head>
<body class="flex flex-col min-h-screen antialiased">
  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <!-- Logo. `shrink-0` não é enfeite: a flex row distribui o que falta de
           espaço encolhendo o logo. Medido a 360px, o `<a>` baixava de 144px
           para 141.8px, o strapline perdia 2.2px e QUEBRAVA em duas linhas
           dentro da barra de `h-16` (offsetHeight 26px numa linha de 12px) — e
           "Instalar App" quebrava junto, em 32px numa linha de 16px. As larguras
           naturais somam 325px (144 + 121 + 44 + 16 de gaps) contra 344px de
           fila: sobra 19px, mas o encolhimento os consumia. Sem encolher os
           dois rótulos cabem inteiros e nada é escondido. A partir de 390px nunca
           houve quebra. -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <img src="/favicon.svg" alt="AetherML" class="w-9 h-9 rounded-xl shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform" />
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900 flex items-center gap-0.5">
            Aether<span class="text-sky-600 font-extrabold">ML</span>
          </span>
          <span class="text-[10px] text-slate-500 block -mt-1 tracking-widest uppercase">RMGV &bull; 5 Dias ML</span>
        </div>
      </a>

      <!-- Links de Navegação: dois itens. As outras quatro leituras são seções do
           Dashboard, acessíveis pelas abas e por rota própria. -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium bg-slate-100 border border-slate-200 rounded-full px-1.5 py-1" aria-label="Navegação principal">
        <a href="/" class={navClass("/")}>Dashboard</a>
        <a href="/docs" class={navClass("/docs")}>
          Docs &bull; CONAMA 491
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Indicador de Status Offline dinâmico -->
        <div id="connection-status" class="hidden items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-[11px] text-amber-700 font-semibold" role="status" aria-live="polite">
          <span class="i-ph-wifi-slash-fill w-3.5 h-3.5"></span>
          <span>Modo Offline</span>
        </div>

        <!-- Botão Instalar App PWA -->
        <button id="pwa-install-btn" class="hidden items-center gap-1.5 px-3.5 py-2 rounded-full bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-sm transition-all active:scale-95 cursor-pointer min-h-[44px]" aria-label="Instalar aplicativo AetherML">
          <span class="i-ph-download-simple-bold w-3.5 h-3.5"></span>
          <span>Instalar App</span>
        </button>

        <!-- Hambúrguer mobile animado (área de toque 44x44px, transição suave para X) -->
        <button
          id="nav-toggle"
          type="button"
          class="md:hidden inline-flex items-center justify-center w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 hover:border-slate-300 active:scale-95 transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-sky-500"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="sr-only">Menu de navegação</span>
          <div class="hamburger-box" aria-hidden="true">
            <span class="hamburger-bar top-bar"></span>
            <span class="hamburger-bar mid-bar"></span>
            <span class="hamburger-bar bot-bar"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Painel mobile -->
    <nav id="mobile-nav" class="md:hidden hidden border-t border-slate-200 bg-white/95 backdrop-blur-xl" aria-label="Navegação móvel">
      <div class="px-4 py-3 flex flex-col gap-1 text-sm font-medium">
        <a href="/" class={mobileNavClass("/")}>Dashboard</a>
        <a href="/docs" class={mobileNavClass("/docs")}>Docs &bull; CONAMA 491</a>
      </div>
    </nav>
  </header>

  <!-- Conteúdo Principal -->
  <!-- `box-border` NÃO é enfeite. O projeto usa `presetUno`, que não embute
     preflight: nenhum elemento da página recebe `box-sizing: border-box`, e o
     padrão do user agent é `content-box`. Com isso, `w-full` + `px-6` somava 48px
     de padding POR CIMA da largura — `main` media 1022px numa janela de 990px e a
     página rolava de lado. Declarar a caixa explicitamente no elemento medido é
     mais seguro que jogar um reset global `*` em cima de toda a tipografia e
     espaçamento já calibrados do produto. -->
<main class="box-border flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6">
    <slot />
  </main>

  <!-- Rodapé com safe-area inset bottom -->
  <footer class="bg-white/70 backdrop-blur border-t border-slate-200 pt-6 text-center text-xs text-slate-500" style="padding-bottom: max(1.5rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)))">
    <div class="max-w-7xl mx-auto px-4 flex flex-col gap-3">
      <nav class="flex items-center justify-center gap-4" aria-label="Rodapé">
        <a href="/" class="hover:text-sky-700 transition-colors font-semibold">Dashboard</a>
        <a href="/docs" class="hover:text-sky-700 transition-colors font-semibold">Docs</a>
      </nav>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <img src="/favicon.svg" alt="" class="w-6 h-6 rounded-lg" />
          <span>AetherML &mdash; Previsão de Qualidade do Ar da Grande Vitória (ES).</span>
        </div>
        <div class="flex items-center gap-4">
          <span>Resolução CONAMA 491/2018</span>
          <span>&bull;</span>
          <span>IEMA / RAMQAr</span>
          <span>&bull;</span>
          <a href="/docs" class="text-sky-700 hover:underline font-semibold">Especificação Técnica</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Registro e Invalidação de Cache do Service Worker -->
  <script is:inline>
    // 1. Purga proativa de caches legados v1 na thread principal
    if ('caches' in window) {
      caches.keys().then((keys) => {
        keys.forEach((key) => {
          if (key.includes('-v1')) {
            console.log('[PWA] Purgando cache legado:', key);
            caches.delete(key);
          }
        });
      });
    }

    // 2. Registro com verificação forçada de update no SW
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js').then((reg) => {
          reg.update();
        }).catch((err) => {
          console.warn('[PWA] Service Worker registration failed:', err);
        });

        let refreshing = false;
        const hadController = Boolean(navigator.serviceWorker.controller);
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (hadController && !refreshing) {
            refreshing = true;
            window.location.reload();
          }
        });
      });
    }
    // Menu mobile com animação de hambúrguer para X
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const isHidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !isHidden);
        toggle.setAttribute('aria-expanded', String(isHidden));
        toggle.setAttribute('aria-label', isHidden ? 'Fechar menu' : 'Abrir menu');
      });
      panel.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          panel.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Abrir menu');
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Abrir menu');
          toggle.focus();
        }
      });
    }

    // PWA Install Prompt & Online/Offline Status
    let deferredPrompt = null;
    const installBtn = document.getElementById('pwa-install-btn');
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (installBtn) {
        installBtn.classList.remove('hidden');
        installBtn.classList.add('inline-flex');
      }
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          installBtn.classList.add('hidden');
          installBtn.classList.remove('inline-flex');
        }
        deferredPrompt = null;
      });
    }

    window.addEventListener('appinstalled', () => {
      if (installBtn) {
        installBtn.classList.add('hidden');
        installBtn.classList.remove('inline-flex');
      }
    });

    const statusEl = document.getElementById('connection-status');
    function updateOnlineStatus() {
      if (!statusEl) return;
      if (navigator.onLine) {
        statusEl.classList.add('hidden');
        statusEl.classList.remove('inline-flex');
      } else {
        statusEl.classList.remove('hidden');
        statusEl.classList.add('inline-flex');
      }
    }
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);
    updateOnlineStatus();
  </script>
</body>
</html>
