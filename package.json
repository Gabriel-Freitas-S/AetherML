{
  "name": "aetherml",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "workers/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check --write ./apps ./packages ./workers",
    "db:migrate": "wrangler d1 migrations apply aetherml-db --local",
    "db:seed": "wrangler d1 execute aetherml-db --local --file=./db/seed.sql"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "typescript": "^5.5.0"
  }
}
